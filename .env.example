# Replace both values outside local development.
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
JWT_SECRET_KEY=replace-with-a-base64-encoded-256-bit-key
# Internal service-to-service HTTP timeouts (milliseconds).
INTERNAL_HTTP_CONNECT_TIMEOUT_MS=3000
INTERNAL_HTTP_READ_TIMEOUT_MS=5000
# Gateway upstream HTTP timeouts.
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT=5s
# Kafka listener used by services that publish/consume integration events.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
